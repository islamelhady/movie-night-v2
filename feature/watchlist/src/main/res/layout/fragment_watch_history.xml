<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="state"
            type="com.elhady.movies.feature.watchlist.presentation.watchhistory.WatchHistoryUiState" />

        <variable
            name="viewModel"
            type="com.elhady.movies.feature.watchlist.presentation.watchhistory.WatchHistoryViewModel" />

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/watchHistoryFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbarLayout_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    android:background="@color/background"
                    android:elevation="2dp"
                    app:layout_collapseMode="pin"
                    app:navigationIcon="@drawable/ic_back_arrow"
                    app:navigationIconTint="@color/on_background_87"
                    app:onClickNavigation="@{() -> viewModel.onEvent(com.elhady.movies.feature.watchlist.presentation.watchhistory.WatchHistoryUiEvent.BackClicked.INSTANCE)}"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginEnd="@dimen/spacing_medium_16dp"
                        android:text="@string/watch_history"
                        android:textAppearance="@style/TextStyle.BodyMedium"
                        android:textColor="@color/on_background_87" />

                </androidx.appcompat.widget.Toolbar>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7">

                    <EditText
                        android:id="@+id/edittext_search"
                        style="@style/TextInputLayoutStyle"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="@dimen/spacing_medium_16dp"
                        android:layout_marginTop="?android:attr/actionBarSize"
                        android:background="@drawable/edittext_background"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="@dimen/spacing_small_8dp"
                        android:drawableTint="@color/on_background_60"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/spacing_medium_16dp"
                        android:text="@{state.searchInput}"
                        android:textAppearance="@style/TextStyle.LabelSmall"
                        android:textColor="@color/on_background_87"
                        android:textColorHint="@color/on_background_60" />

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/watch_history_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_medium_16dp"
            app:isVisible="@{!state.isLoading &amp;&amp; !state.isFailure}"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            tools:listitem="@layout/watch_history_recycler_view_card" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_animation_view_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:isVisible="@{(!state.isLoading) &amp;&amp; state.movies.isEmpty() &amp;&amp; !state.isFailure}"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/empty_state"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/textview_no_items_found"
            style="@style/TextStyle.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_medium_16dp"
            android:gravity="center"
            android:text="@string/no_items_found"
            android:textColor="@color/on_background_60"
            app:isVisible="@{(!state.isLoading) &amp;&amp; state.movies.isEmpty() &amp;&amp; !state.isFailure}" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/progressBar"
            android:layout_width="@dimen/lottie_loading_size"
            android:layout_height="@dimen/lottie_loading_size"
            android:layout_gravity="center"
            app:isVisible="@{state.isLoading}"
            app:lottie_autoPlay="true"
            app:lottie_colorFilter="@color/primary"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_loading" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            app:isVisibleOrGone="@{state.isFailure}">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_animation"
                android:layout_width="@dimen/lottie_error_size"
                android:layout_height="@dimen/lottie_error_size"
                android:layout_gravity="center"
                app:errorAnimation="@{state.error}"
                app:lottie_autoPlay="true"
                app:lottie_colorFilter="@color/primary"
                app:lottie_loop="true" />

            <com.google.android.material.button.MaterialButton
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_medium_16dp"
                android:onClick="@{() -> viewModel.onEvent(com.elhady.movies.feature.watchlist.presentation.watchhistory.WatchHistoryUiEvent.RetryClicked.INSTANCE)}"
                android:text="@string/try_again" />
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
